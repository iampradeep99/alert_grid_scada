{
  "name": "alert-grid-scada-api",
  "version": "1.0.0",
  "description": "Node.js API boilerplate with scada-alert module",
  "main": "src/index.js",
  "type": "module",
  "scripts": {
    "start": "NODE_ENV=development nodemon src/index.js",
    "dev": "node src/index.js",
    "prod": "NODE_ENV=production node src/index.js",
    "worker:alarm": "node src/workers/alarm.worker.js",
    "worker:analog": "node src/workers/analog.worker.js",
    "worker:point": "node src/workers/point.worker.js",
    "worker:nms": "node src/workers/nms.worker.js",
    "worker:autoscale": "node src/workers/autoScaler.runner.js",
    "socket:load-test": "node scripts/socket-load-test.js",
