    "express": "^4.18.2",
    "pg": "^8.23.1",
    "socket.io": "^4.8.4"
  },
  "devDependencies": {
    "nodemon": "^3.1.9",
    "socket.io-client": "^4.8.1"
  },
  "engines": {
    "node": ">=18"
  }
